NEXT_PUBLIC_URL_API=http://localhost:5000
NEXT_PUBLIC_COMPANY_SLUG=nairim
NEXT_PUBLIC_COMPANY_NAME=Nairim Holding

# Server-only. Obtain a free key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Basemaps do CARTO (tiles do mapa). Sem esta chave os tiles voltam com a marca
# d'agua "API KEY REQUIRED" e o app cai no OpenStreetMap como fallback.
# Chave publica por natureza (tile e requisicao do navegador): restrinja por
# dominio no painel em https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=

# Cobranças automáticas por WhatsApp via Evolution API (self-hosted/Baileys).
# Aplicação local: http://127.0.0.1:8081
# Container front-nairim: o compose substitui por http://evolution-api:8080
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_DB_PASSWORD=
EVOLUTION_PUBLIC_URL=http://localhost:8081

# Segredo usado pelo agendador das rotinas automáticas.
CRON_SECRET=
