NEXT_PUBLIC_URL_API=http://localhost:5000
NEXT_PUBLIC_COMPANY_SLUG=nairim
NEXT_PUBLIC_COMPANY_NAME=Nairim Holding

# Server-only. Obtain a free key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Basemaps do CARTO (tiles do mapa). Sem esta chave os tiles voltam com a marca
# d'agua "API KEY REQUIRED" e o app cai no OpenStreetMap como fallback.
# Chave publica por natureza (tile e requisicao do navegador): restrinja por
# dominio no painel em https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=

# Cobranças automáticas por WhatsApp via Evolution API (self-hosted/Baileys).
# Aplicação local: http://127.0.0.1:8081
# Container front-nairim: o compose substitui por http://evolution-api:8080
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_DB_PASSWORD=
EVOLUTION_PUBLIC_URL=http://localhost:8081

# Segredo usado pelo agendador das rotinas automáticas.
CRON_SECRET=

# MongoDB de PRODUÇÃO: instância, volume e senha exclusivos (container
# mongodb-logs-prod). Teste e homologação nunca usam esta credencial.
MONGODB_LOGS_USER=nairim_logs
MONGODB_LOGS_PASSWORD=configure_uma_senha_aleatoria
MONGODB_LOGS_PORT=27018
MONGODB_LOGS_DATABASE=nairim_logs
MONGODB_LOGS_URI=mongodb://nairim_logs:configure_uma_senha_aleatoria@127.0.0.1:27018/?authSource=admin
# Mesmo PostgreSQL do DATABASE_URL; localhost no Docker deve ser host.docker.internal
# Na VPS use o DNS interno do compose: postgresql://nairim:nairim@postgres:5432/nairim_db
LOGS_WORKER_DATABASE_URL=postgresql://nairim:nairim@host.docker.internal:5432/nairim_db

# MongoDB de TESTE/HOMOLOGAÇÃO: segunda instância (mongodb-logs-staging),
# volume e senha próprios, separados entre si por database.
# Senha DIFERENTE da de produção — é o que garante o isolamento.
MONGODB_LOGS_STAGING_USER=nairim_logs
MONGODB_LOGS_STAGING_PASSWORD=configure_outra_senha_aleatoria
MONGODB_LOGS_STAGING_PORT=27019

# Um serviço de transferência por PostgreSQL (cada um tem sua fila AuditLogOutbox).
MONGODB_LOGS_TEST_DATABASE=nairim_logs_test
LOGS_WORKER_TEST_DATABASE_URL=postgresql://nairim:nairim@postgres-test-2:5432/nairim_test2_db
MONGODB_LOGS_HOMOLOG_DATABASE=nairim_logs_homolog
LOGS_WORKER_HOMOLOG_DATABASE_URL=postgresql://nairim:nairim@postgres-homolog:5432/nairim_homolog_db
