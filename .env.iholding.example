# Copie para .env.iholding. Nunca use o .env da Nairim.
APP_DOMAIN=iholding.com.br
CDN_DOMAIN=cdn.iholding.com.br
NEXT_PUBLIC_COMPANY_SLUG=iholding
NEXT_PUBLIC_COMPANY_NAME=I Holding
NEXT_PUBLIC_CARTO_API_KEY=
GEOAPIFY_API_KEY=

# Rede e resolver ja existentes no Traefik da VPS.
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERTRESOLVER=myresolver

# A imagem MinIO abaixo e construida automaticamente pelo up.sh.
# Informe uma imagem mc homologada com tag fixa ou digest.
# Consulte deploy/iholding/README.md antes de escolher a imagem MinIO.
MINIO_IMAGE=iholding-minio:2025-10-15
MINIO_MC_IMAGE=
POSTGRES_IMAGE=postgres:16-alpine
MONGODB_IMAGE=mongo:8.0

# Gere senhas DIFERENTES: openssl rand -hex 32 (uma execucao por segredo).
# Use hexadecimal para nao precisar escapar as URIs PostgreSQL/MongoDB.
POSTGRES_PASSWORD=
MONGODB_LOGS_USER=iholding_logs
MONGODB_LOGS_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=8h
CRON_SECRET=
MINIO_ROOT_USER=iholding_storage_admin
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=iholding_app
MINIO_SECRET_KEY=
MINIO_BUCKET=imagens
MINIO_REGION=us-east-1

# Servico bootstrap (executado uma vez pelo operador; nao entra no front).
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_BIRTH_DATE=
# Valores aceitos pelo schema: MALE, FEMALE, OTHER.
BOOTSTRAP_ADMIN_GENDER=
